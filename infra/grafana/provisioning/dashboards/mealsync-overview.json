{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "gauge", "name": "Gauge", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "MealSync container and host metrics via cAdvisor. Spring Boot application metrics panel is included but will show no data until Meet adds spring-boot-starter-actuator + micrometer-registry-prometheus to pom.xml.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Container Resource Usage",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.6},
              {"color": "red", "value": 0.85}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=~\"backend|frontend|db|prometheus|grafana\",id!=\"/\"}[2m])",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "title": "CPU Usage by Container (cores/s)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "id": 2,
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "container_memory_working_set_bytes{container_label_com_docker_compose_service=~\"backend|frontend|db|prometheus|grafana\",id!=\"/\"}",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "title": "Memory Working Set by Container",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 3,
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(container_network_receive_bytes_total{container_label_com_docker_compose_service=~\"backend|frontend\",id!=\"/\"}[2m])",
          "legendFormat": "rx {{container_label_com_docker_compose_service}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(container_network_transmit_bytes_total{container_label_com_docker_compose_service=~\"backend|frontend\",id!=\"/\"}[2m])",
          "legendFormat": "tx {{container_label_com_docker_compose_service}}",
          "refId": "B"
        }
      ],
      "title": "Network I/O — Backend & Frontend",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red", "value": 0}
          ]}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area"},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "count(container_last_seen{container_label_com_docker_compose_service=~\"backend|frontend|db|prometheus|grafana\"})",
          "legendFormat": "Running Containers",
          "refId": "A"
        }
      ],
      "title": "Running MealSync Containers",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17},
      "id": 101,
      "title": "Spring Boot Application Metrics (requires Actuator — see notes)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "id": 5,
      "description": "⚠️ No data until Meet adds spring-boot-starter-actuator + micrometer-registry-prometheus to pom.xml. See prometheus.yml for exact steps.",
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(http_server_requests_seconds_count{job=\"mealsync-backend\"}[1m])",
          "legendFormat": "{{method}} {{uri}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate (backend) ⚠️ Actuator required",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "s"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "id": 6,
      "description": "⚠️ No data until Meet adds spring-boot-starter-actuator + micrometer-registry-prometheus to pom.xml.",
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"calcs": ["mean", "p99"], "displayMode": "table", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"mealsync-backend\"}[5m])) by (le, uri))",
          "legendFormat": "p95 {{uri}}",
          "refId": "A"
        }
      ],
      "title": "HTTP p95 Latency (backend) ⚠️ Actuator required",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mealsync", "containers", "spring-boot"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "MealSync — Container & Application Metrics",
  "uid": "mealsync-main",
  "version": 1
}
