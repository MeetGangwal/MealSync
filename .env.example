# MealSync Backend — Environment Variables
# Copy this file and fill in real values.
# NEVER commit a file containing real passwords or secrets.

# MySQL database password for the mealsync database
# Recommended: create a dedicated mealsync_app user instead of using root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT signing secret — must be at least 32 characters (256 bits) for HS256
# Generate with: openssl rand -base64 32
JWT_SECRET=generate-a-real-random-secret-with-openssl-rand-base64-32
