# ─────────────────────────────────────────────────────────────────────────────
# MealSync — Environment Variable Template
#
# HOW TO USE:
#   cp .env.example .env
#   # Edit .env with real values
#   docker compose up -d
#
# IMPORTANT:
#   • .env is git-ignored. Never commit it.
#   • This file (.env.example) contains ONLY placeholders — never real secrets.
#
# COMPOSE vs APPLICATION env vars — two separate concerns:
#   • Docker Compose reads .env at "docker compose up" time to interpolate
#     variables inside docker-compose.yml (e.g. ${DB_PASSWORD}).
#   • Spring Boot reads environment variables injected into the container at
#     runtime (set via the `environment:` block in docker-compose.yml).
#   • Both use the same variable names here; Compose passes them through.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL 8.4) ───────────────────────────────────────────────────────
# Database name created inside the MySQL container
DB_NAME=mealsync

# Application database user credentials
DB_USERNAME=mealsync_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# MySQL root password — REQUIRED: docker compose refuses to start without it
DB_ROOT_PASSWORD=CHANGE_ME_root_password_here

# ── JWT Signing Secret ────────────────────────────────────────────────────────
# Must be at least 32 random bytes (256 bits) for HMAC-SHA256.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRATION_MS=86400000

# ── Grafana Admin ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# ── Database host (local runs only) ───────────────────────────────────────────
# The backend builds its JDBC URL from DB_HOST, DB_PORT and DB_NAME.
# Docker Compose sets DB_HOST=db and Kubernetes sets DB_HOST=mysql automatically.
# For scripts/start-backend.sh against a MySQL on this machine the defaults are
# DB_HOST=localhost and DB_PORT=3306; uncomment only to override them.
# DB_HOST=localhost
# DB_PORT=3306

# ── Demo accounts (local demos only) ──────────────────────────────────────────
# Disabled by default. When true, DataSeeder creates aryan@spit.edu (student) and
# admin@spit.mess (admin) with the two passwords below; if either is empty, the
# demo accounts are skipped. Never enable this in a shared or public deployment.
MEALSYNC_SEED_DEMO_USERS=false
MEALSYNC_DEMO_STUDENT_PASSWORD=
MEALSYNC_DEMO_ADMIN_PASSWORD=

# ── Host ports (optional) ─────────────────────────────────────────────────────
# Change only if a default port is already used on your machine.
# FRONTEND_HOST_PORT=3000
# BACKEND_HOST_PORT=8080
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3001
# CADVISOR_HOST_PORT=8090
