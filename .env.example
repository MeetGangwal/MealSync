# ─────────────────────────────────────────────────────────────────────────────
# MealSync — Environment Variable Template
#
# HOW TO USE:
#   cp .env.example .env
#   # Edit .env with real values
#   docker compose up -d
#
# IMPORTANT:
#   • .env is git-ignored. Never commit it.
#   • This file (.env.example) contains ONLY placeholders — never real secrets.
#
# COMPOSE vs APPLICATION env vars — two separate concerns:
#   • Docker Compose reads .env at "docker compose up" time to interpolate
#     variables inside docker-compose.yml (e.g. ${DB_PASSWORD}).
#   • Spring Boot reads environment variables injected into the container at
#     runtime (set via the `environment:` block in docker-compose.yml).
#   • Both use the same variable names here; Compose passes them through.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL 8.4) ───────────────────────────────────────────────────────
# Database name created inside the MySQL container
DB_NAME=mealsync

# Application database user credentials
DB_USERNAME=mealsync_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# MySQL root password — REQUIRED: docker compose refuses to start without it
DB_ROOT_PASSWORD=CHANGE_ME_root_password_here

# ── JWT Signing Secret ────────────────────────────────────────────────────────
# Must be at least 32 random bytes (256 bits) for HMAC-SHA256.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRATION_MS=86400000

# ── Grafana Admin ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# ── Local backend run without Docker (scripts/start-backend.sh) ───────────────
# start-backend.sh loads ./.env (or backend/.env). The backend on this branch
# still reads SPRING_DATASOURCE_* from application.yml, not the DB_* names above,
# and its JDBC URL is fixed to localhost:3306/mealsync. Until the backend is
# switched to DB_* (backend integration phase), set these to the same values.
SPRING_DATASOURCE_USERNAME=mealsync_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_strong_password_here

# Demo accounts seeded by DataSeeder (mealsync.seed.demo-users, default: true
# in code). Keep false unless you are running a local demo.
MEALSYNC_SEED_DEMO_USERS=false
